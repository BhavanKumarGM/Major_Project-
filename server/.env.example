# Server Environment Configuration Example
PORT=5050
SARVAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Leave empty unless you run Ollama locally (e.g. http://127.0.0.1:11434)
OLLAMA_URL=

# Security
# Interface to listen on. Keep 127.0.0.1 unless the API must be reachable from other machines.
HOST=127.0.0.1
# When set, changing API keys or model settings requires this token (entered in Settings).
ADMIN_TOKEN=
# Comma-separated browser origins allowed to call the API (defaults to the Vite dev server).
CORS_ORIGINS=

# Behaviour
# Set to false to return an error instead of simulated demo answers for providers without a key.
ALLOW_SIMULATION=true
# Where conversations, analytics and saved settings are stored (default: server/data).
DATA_DIR=

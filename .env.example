# AI Hive Mind Environment Configuration Example
# Copy this file to .env and provide your actual API keys.
PORT=5050
VITE_PORT=5173

# Optional LLM Provider API Keys
SARVAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Leave empty unless you run Ollama locally (e.g. http://127.0.0.1:11434)
OLLAMA_URL=

# Security
# Interface to listen on. Keep 127.0.0.1 unless the API must be reachable from other machines.
HOST=127.0.0.1
# When set, changing API keys or model settings requires this token (entered in Settings).
ADMIN_TOKEN=
# Comma-separated browser origins allowed to call the API (defaults to the Vite dev server).
CORS_ORIGINS=

# Behaviour
# Set to false to return an error instead of simulated demo answers for providers without a key.
ALLOW_SIMULATION=true
# Where conversations, analytics and saved settings are stored (default: server/data).
DATA_DIR=
# OpenAI API model used for the gpt-4o catalog entry (API model ids differ from ChatGPT website names)
OPENAI_MODEL=gpt-4o
# Per-request provider timeout in milliseconds
GENERATION_TIMEOUT_MS=120000
# LLM judge (optional "LLM judge" checkbox): per-call timeout and retry wait
JUDGE_TIMEOUT_MS=60000
JUDGE_RETRY_DELAY_MS=1500
# Python used to syntax-check Python answers (never runs them); auto-detected when unset
# PYTHON_BIN=python
